+def _project_easyeda_location(project_dir, lib_name="EasyEDA"):
+    """Use a project's existing libraries/EasyEDA folder for C-number imports."""
+    nested = Path(project_dir) / "libraries" / "EasyEDA"
+    if lib_name == "EasyEDA" and nested.is_dir():
+        return nested, "${KIPRJMOD}/libraries/EasyEDA"
+    return Path(project_dir), "${KIPRJMOD}"
